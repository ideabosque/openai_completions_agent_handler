# OpenAI Completions Agent Handler - Smoke Test Environment
# Copy this file to .env and fill in your actual values.

# Path to the parent directory containing silvaengine_utility, ai_agent_handler,
# and openai_completions_agent_handler. Used by test_chatbot.py to wire sys.path
# for standalone runs.
base_dir=C:/Users/bibo7/gitrepo/silvaengine

# Choose one target profile below and leave reasoning flags from other
# providers unset. Active default: local SGLang Qwen3.
openai_api_key=EMPTY
base_url=http://127.0.0.1:30000/v1
model=Qwen/Qwen3-4B

# Bedrock Mantle examples (set openai_api_key to a Bedrock API key):
# base_url=https://bedrock-mantle.us-east-1.api.aws/v1
# model=zai.glm-5
# model=zai.glm-4.7
# model=zai.glm-4.7-flash
# model=openai.gpt-oss-120b
# model=openai.gpt-oss-20b
# model=qwen.qwen3-32b
# model=qwen.qwen3-next-80b-a3b-instruct
# model=deepseek.v3.2
# model=minimax.minimax-m2.5
# model=mistral.magistral-small-2509
# model=nvidia.nemotron-super-3-120b
# model=google.gemma-3-27b-it
# model=moonshotai.kimi-k2.5
# reasoning_effort=high

# Direct Z.AI GLM example:
# base_url=https://api.z.ai/api/paas/v4
# model=glm-4.5
# thinking_type=enabled
# clear_thinking=false

# Where to put the agent's instructions.
#   system    - default; works for OpenAI, Qwen, Llama, Mistral, etc.
#   developer - newer OpenAI models (gpt-4.1, gpt-5, ...)
#   user      - REQUIRED for Gemma (1/2/3) and any model whose chat template
#               rejects the system role; merges instructions into the first
#               user message.
instructions_role=system

# Internal MCP server used by the test agent's `mcp_servers` block.
# The MCP endpoint is constructed as: {mcp_base_url}/{endpoint_id}/mcp
# mcp_api_key is sent as X-Api-Key; part_id is sent as Part-Id.
mcp_base_url=https://fzo7p73k2j.execute-api.us-west-2.amazonaws.com/beta/core
mcp_api_key=YOUR_MCP_API_KEY
mcp_bearer_token=YOUR_MCP_BEARER_TOKEN
endpoint_id=sglang-local
part_id=test-part

# Agent settings consumed by test_chatbot.py.
# prompt_file resolves to a *.md next to this file. Prompt files are
# gitignored (see .gitignore rule `tests/*`) — bring your own or drop a
# file next to test_chatbot.py, then point at it here.
prompt_file=travel_agent.md
agent_name=SGLang Chat Completions Test Agent
agent_description=Test agent for SGLang local server via OpenAI Chat Completions API.

# Role used when the handler mirrors tool results into `_short_term_memory`.
# Convention by handler family:
#   - Chat Completions (this handler):  "tool"      ← spec-compliant, default
#   - OpenAI Responses / Ollama:        "developer"
#   - Anthropic / Gemini:               "assistant"
# Only change this if you round-trip messages through ai_agent_core_engine
# with a different family's builder. For most Chat Completions users, leave it
# unset and the default "tool" applies.
# tool_call_role=tool

# Optional. Enables [TIMELINE] log lines from the handler.
# enable_timeline_log=true

# Local SGLang/Qwen3 reasoning settings:
# enable_thinking=true
# separate_reasoning=true

# Direct Z.AI GLM request fields; omit for Bedrock and SGLang:
# thinking_type=enabled
# clear_thinking=false

# Bedrock Mantle reasoning control; tested with zai.glm-5. It can be exercised
# with other Chat-Completions-compatible Bedrock models, but returned reasoning
# is model-dependent and should be checked through test_tool_call.py.
# reasoning_effort=high

# Defensive fallback for servers that emit inline <think>...</think> blocks in
# `content` instead of populating `delta.reasoning_content` (vLLM + GLM-5
# parser bug #29763, DeepSeek/Qwen3 without a reasoning parser, etc.).
# Off by default; only enable if your provider's reasoning parser is broken.
# enable_think_tag_split=true
# tool_call_role=developer